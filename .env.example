# Copy to .env.local and fill in. On Vercel these are set in Project Settings → Environment Variables;
# `vercel env pull .env.local` pulls them down (and also writes VERCEL_OIDC_TOKEN).

# Sentry — set automatically by the Vercel Sentry integration.
# DSN: Sentry → Project Settings → Client Keys (DSN). Safe to expose to the browser.
NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<orgId>.ingest.us.sentry.io/<projectId>
# Optional server-side override; falls back to NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=
# Build-time only, for source map uploads. Keep SENTRY_AUTH_TOKEN secret.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Vercel Flags SDK secret (used by the flags toolbar / overrides).
FLAGS_SECRET=

# Optional: raises the GitHub API rate limit for repo data.
GITHUB_TOKEN=

# SociableKit widget that renders my LinkedIn posts on /linkedin
LINKEDIN_POSTS_WIDGET_URL=

# Elfsight widget that renders my YouTube channel on /youtube
YOUTUBE_WIDGET_URL=
